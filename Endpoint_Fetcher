javascript:void(function () {
    let panel = document.createElement('div');
    panel.style.cssText = `
        position: fixed;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 300px;
        background: #1a1a1a;
        color: #990000;
        z-index: 999999;
        padding: 20px;
        overflow: auto;
        font-family: monospace;
        resize: vertical;
        min-height: 150px;
        max-height: 90%;
        border-top: 2px solid #990000;
        box-sizing: border-box;
        transition: all 0.3s ease;
    `;

    panel.innerHTML = `
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
            <h3 style="color: #990000; margin: 0; font-size: 24px;">🔍 KreSkoN's Scanner</h3>
            <div style="display: flex; align-items: center;">
                <button id="downloadBtn" style="background: #505050; color: white; border: none; padding: 5px 10px; font-size: 14px; cursor: pointer; border-radius: 3px; margin-right: 10px;">Download Results</button>
                <button id="expandPanel" style="background: #505050; color: white; border: none; padding: 5px 10px; font-size: 14px; cursor: pointer; border-radius: 3px; margin-right: 10px;">⤢ Expand</button>
                <button id="restorePanel" style="background: #505050; color: white; border: none; padding: 5px 10px; font-size: 14px; cursor: pointer; border-radius: 3px; display: none;">⤡ Restore</button>
                <button id="closePanel" style="background: #505050; color: white; border: none; padding: 5px 10px; font-size: 14px; cursor: pointer; border-radius: 3px; margin-right: 10px;">✖ Close</button>
            </div>
        </div>
        <div id="results" style="white-space: nowrap;">⏳ Scanning...</div>
    `;

    document.body.appendChild(panel);

    document.getElementById('closePanel').addEventListener('click', () => {
        panel.remove();
    });

    document.getElementById('expandPanel').addEventListener('click', () => {
        panel.style.height = '100%';
        panel.style.width = '100%';
        panel.style.top = '0';
        panel.style.bottom = 'unset';
        panel.style.resize = 'none';
        document.getElementById('expandPanel').style.display = 'none';
        document.getElementById('restorePanel').style.display = 'inline-block';
    });

    document.getElementById('restorePanel').addEventListener('click', () => {
        panel.style.height = '300px';
        panel.style.width = '100%';
        panel.style.bottom = '0';
        panel.style.top = 'unset';
        panel.style.resize = 'vertical';
        document.getElementById('expandPanel').style.display = 'inline-block';
        document.getElementById('restorePanel').style.display = 'none';
    });

    let currentDomain = window.location.hostname;

    function findUrls() {
        let urls = [];
        let sources = [
            ...document.getElementsByTagName('a'),
            ...document.getElementsByTagName('script'),
            ...document.getElementsByTagName('img'),
            ...document.getElementsByTagName('link'),
            ...document.getElementsByTagName('form')
        ];

        sources.forEach(element => {
            if (element.href) urls.push(element.href);
            if (element.src) urls.push(element.src);
            if (element.action) urls.push(element.action);
        });

        let content = document.documentElement.innerHTML;

        let urlPattern = /(?:url\(|href="|src="|action="|url:|endpoint:|path:|route:)\s*['"]?([^'"\)\s>]+)/gi;
        let match;
        while ((match = urlPattern.exec(content)) !== null) {
            if (match[1] && !match[1].startsWith('data:')) urls.push(match[1]);
        }

        let scriptPattern = /"[^"]*"|'[^']*'/g;
        let scripts = document.documentElement.innerHTML.match(scriptPattern) || [];
        scripts.forEach(script => {
            let urlMatches = script.match(/(?:\/[a-zA-Z0-9_-]+)+(?:\.[a-zA-Z0-9]+)?/g) || [];
            urlMatches.forEach(url => urls.push(url));
        });

        performance.getEntriesByType('resource').forEach(entry => {
            urls.push(entry.name);
        });

        return [...new Set(urls)];
    }

    function filterForPotentialAttacks(urls) {
        const attackPatterns = [
            /<script.*?>.*?<\/script>/i,
            /javascript:/i,
            /union.*?select.*?from/i,
            /select.*?from/i,
            /' OR 1=1/i,
            /--/i,
            /;--/i
        ];

        return urls.filter(url => {
            return attackPatterns.some(pattern => pattern.test(url));
        });
    }

    let allUrls = findUrls();
    let attackUrls = filterForPotentialAttacks(allUrls);
    let normalUrls = allUrls.filter(url => !attackUrls.includes(url));

    let resultsContainer = document.getElementById('results');
    let resultsText = '';

    if (attackUrls.length > 0) {
        resultsContainer.innerHTML = `
            <div style="margin: 10px 0; color: #990000;">⚠️ Potential Attack URLs:</div>
            <div style="background: #333; padding: 10px; border-radius: 5px;">
                ${attackUrls.map(url => `
                    <div style="margin: 5px 0;">
                        <a href="${url}" target="_blank" style="color: white; text-decoration: none; padding: 5px; background: #555; border-radius: 3px; display: inline-block; word-break: break-word;" title="Open in new tab">${url}</a>
                    </div>`).join('')}
            </div>
        `;
    }

    if (normalUrls.length > 0) {
        resultsContainer.innerHTML += `
            <div style="margin: 10px 0; color: #990000;">✅ Found ${normalUrls.length} URLs and endpoints on ${currentDomain}:</div>
            <div style="background: #333; padding: 10px; border-radius: 5px;">
                ${normalUrls.map(url => `
                    <div style="margin: 5px 0;">
                        <a href="${url}" target="_blank" style="color: white; text-decoration: none; padding: 5px; background: #555; border-radius: 3px; display: inline-block; word-break: break-word;" title="Open in new tab">${url}</a>
                    </div>`).join('')}
            </div>
        `;
        resultsText = `Found ${normalUrls.length} URLs and endpoints on ${currentDomain}:\n\n${normalUrls.join('\n')}`;
    } else {
        resultsContainer.innerHTML += `<div style="color: #990000;">❌ No URLs found on the current page.</div>`;
        resultsText = 'No URLs found on the current page.';
    }

    document.getElementById('downloadBtn').addEventListener('click', () => {
        let blob = new Blob([resultsText], { type: 'text/plain;charset=utf-8' });
        let link = document.createElement('a');
        link.href = URL.createObjectURL(blob);
        link.download = `${currentDomain}_scan_results.txt`;
        link.click();
    });
})();
