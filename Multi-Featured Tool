javascript:void(function(){
    let panel=document.createElement('div');
    panel.style.cssText='position:fixed;bottom:0;left:0;width:100%;height:300px;background:#1a1a1a;color:#990000;z-index:999999;padding:20px;overflow:auto;font-family:monospace;resize:vertical;min-height:150px;max-height:90%;border-top:2px solid #990000;box-sizing:border-box;transition:all 0.3s ease;';
    panel.innerHTML=`<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;">
        <h3 style="color:#990000;margin:0;font-size:24px;">🔍 KreSkoN's Link Suite</h3>
        <div style="display:flex;align-items:center;">
            <button id="scanBtn" style="background:#505050;color:white;border:none;padding:5px 10px;font-size:14px;cursor:pointer;border-radius:3px;margin-right:10px;">🔄 Scan Status Codes</button>
            <button id="sortBtn" style="background:#505050;color:white;border:none;padding:5px 10px;font-size:14px;cursor:pointer;border-radius:3px;margin-right:10px;">Sort: None</button>
            <button id="downloadBtn" style="background:#505050;color:white;border:none;padding:5px 10px;font-size:14px;cursor:pointer;border-radius:3px;margin-right:10px;">Download Results</button>
            <button id="expandPanel" style="background:#505050;color:white;border:none;padding:5px 10px;font-size:14px;cursor:pointer;border-radius:3px;margin-right:10px;">⤢ Expand</button>
            <button id="restorePanel" style="background:#505050;color:white;border:none;padding:5px 10px;font-size:14px;cursor:pointer;border-radius:3px;margin-right:10px;display:none;">⤡ Restore</button>
            <button id="closePanel" style="background:#505050;color:white;border:none;padding:5px 10px;font-size:14px;cursor:pointer;border-radius:3px;">✖ Close</button>
        </div>
    </div>
    <div style="margin-bottom:10px;">
        <input id="searchInput" type="text" placeholder="Search URLs..." style="width:100%;padding:5px;font-size:14px;border-radius:3px;margin-bottom:10px;"/>
        <select id="filterSelect" style="padding:5px 10px;font-size:14px;border-radius:3px;margin-bottom:10px;">
            <option value="all">All</option>
            <option value="attack">Potential Attacks</option>
            <option value="sqli">SQLi</option>
            <option value="lfi">LFI</option>
            <option value="open_redirect">Open Redirect</option>
            <option value="xss">XSS</option>
        </select>
    </div>
    <div id="results" style="white-space:nowrap;">⏳ Scanning...</div>`;

    document.body.appendChild(panel);
    document.getElementById('closePanel').addEventListener('click',()=>{panel.remove();});
    document.getElementById('expandPanel').addEventListener('click',()=>{
        panel.style.height='100%';
        panel.style.width='100%';
        panel.style.top='0';
        panel.style.bottom='unset';
        panel.style.resize='none';
        document.getElementById('expandPanel').style.display='none';
        document.getElementById('restorePanel').style.display='inline-block';
    });
    document.getElementById('restorePanel').addEventListener('click',()=>{
        panel.style.height='300px';
        panel.style.width='100%';
        panel.style.bottom='0';
        panel.style.top='unset';
        panel.style.resize='vertical';
        document.getElementById('expandPanel').style.display='inline-block';
        document.getElementById('restorePanel').style.display='none';
    });

    let allUrls = findUrls();
    let statuses = {}; // Сохраняет статусы для каждой ссылки
    let sortState = 0; // 0 - без сортировки, 1 - по возрастанию, 2 - по убыванию

    function findUrls() {
        let urls = [];
        let sources = [...document.getElementsByTagName('a'), ...document.getElementsByTagName('script'), ...document.getElementsByTagName('img'), ...document.getElementsByTagName('link'), ...document.getElementsByTagName('form')];
        sources.forEach(element => {
            if(element.href) urls.push(element.href);
            if(element.src) urls.push(element.src);
            if(element.action) urls.push(element.action);
        });
        let content = document.documentElement.innerHTML;
        let urlPattern = /(?:url\(|href="|src="|action="|url:|endpoint:|path:|route:)\s*['"]?([^'"\)\s>]+)/gi;
        let match;
        while((match=urlPattern.exec(content))!==null) {
            if(match[1] && !match[1].startsWith('data:')) urls.push(match[1]);
        }
        performance.getEntriesByType('resource').forEach(entry => { urls.push(entry.name); });
        return [...new Set(urls)];
    }

    async function getStatusCode(url) {
        try {
            let response = await fetch(url, { method: 'HEAD', cache: 'no-cache' });
            return response.status;
        } catch (error) {
            return null;
        }
    }

    function getStatusColor(statusCode) {
        if (statusCode >= 200 && statusCode < 300) return 'green';
        if (statusCode >= 300 && statusCode < 400) return 'blue';
        if (statusCode >= 400 && statusCode < 500) return 'red';
        if (statusCode >= 500 && statusCode < 600) return 'darkred';
        return 'gray';
    }

    async function scanStatuses() {
        for (let url of allUrls) {
            let statusCode = await getStatusCode(url);
            statuses[url] = statusCode;
        }
        updateResults(allUrls);
    }

    function sortUrls(urls) {
        if (sortState === 1) {
            return urls.sort((a, b) => (statuses[a] || 0) - (statuses[b] || 0));
        } else if (sortState === 2) {
            return urls.sort((a, b) => (statuses[b] || 0) - (statuses[a] || 0));
        }
        return urls; // Без сортировки
    }

    async function updateResults(urls) {
        let resultsContainer = document.getElementById('results');
        let sortedUrls = sortUrls(urls);
        let resultsHtml = '';
        for (let url of sortedUrls) {
            let statusCode = statuses[url];
            let statusColor = statusCode ? getStatusColor(statusCode) : 'gray';
            resultsHtml += `
                <div style="margin:5px 0;">
                    <span style="color:${statusColor};font-weight:bold;min-width:70px;display:inline-block;">${statusCode || 'N/A'}</span>
                    <a href="${url}" target="_blank" style="color:white;text-decoration:none;padding:5px;background:#555;border-radius:3px;display:inline-block;word-break:break-word;" title="Open in new tab">${url}</a>
                </div>
            `;
        }
        resultsContainer.innerHTML = urls.length > 0 ? 
            `<div style="margin:10px 0;color:#990000;">✅ Found ${urls.length} URLs:</div><div style="background:#333;padding:10px;border-radius:5px;">${resultsHtml}</div>` :
            `<div style="color:#990000;">❌ No URLs found.</div>`;
    }

    document.getElementById('scanBtn').addEventListener('click', scanStatuses);

    document.getElementById('sortBtn').addEventListener('click', () => {
        sortState = (sortState + 1) % 3; // Переключение между 0, 1 и 2
        let sortText = ['None', 'Asc', 'Desc'][sortState];
        document.getElementById('sortBtn').innerText = `Sort: ${sortText}`;
        updateResults(allUrls);
    });

    updateResults(allUrls);
})();
