javascript:void(function(){let panel=document.createElement('div');panel.style.cssText='position:fixed;bottom:0;left:0;width:100%;height:300px;background:#1a1a1a;color:#990000;z-index:999999;padding:20px;overflow:auto;font-family:monospace;resize:vertical;min-height:150px;max-height:90%;border-top:2px solid #990000;box-sizing:border-box;transition:all 0.3s ease;';panel.innerHTML=`<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;"><h3 style="color:#990000;margin:0;font-size:24px;">🔍 Open Redirect Scanner</h3><div style="display:flex;align-items:center;"><button id="downloadBtn" style="background:#505050;color:white;border:none;padding:5px 10px;font-size:14px;cursor:pointer;border-radius:3px;margin-right:10px;">Download Results</button><button id="expandPanel" style="background:#505050;color:white;border:none;padding:5px 10px;font-size:14px;cursor:pointer;border-radius:3px;margin-right:10px;">⤢ Expand</button><button id="restorePanel" style="background:#505050;color:white;border:none;padding:5px 10px;font-size:14px;cursor:pointer;border-radius:3px;display:none;">⤡ Restore</button><button id="closePanel" style="background:#505050;color:white;border:none;padding:5px 10px;font-size:14px;cursor:pointer;border-radius:3px;margin-right:10px;">✖ Close</button></div></div><div style="margin-bottom:10px;"><input id="searchInput" type="text" placeholder="Search URLs..." style="width:100%;padding:5px;font-size:14px;border-radius:3px;margin-bottom:10px;"/></div><div id="results" style="white-space:nowrap;">⏳ Scanning...</div>`;document.body.appendChild(panel);document.getElementById('closePanel').addEventListener('click',()=>{panel.remove();});document.getElementById('expandPanel').addEventListener('click',()=>{panel.style.height='100%';panel.style.width='100%';panel.style.top='0';panel.style.bottom='unset';panel.style.resize='none';document.getElementById('expandPanel').style.display='none';document.getElementById('restorePanel').style.display='inline-block';});document.getElementById('restorePanel').addEventListener('click',()=>{panel.style.height='300px';panel.style.width='100%';panel.style.bottom='0';panel.style.top='unset';panel.style.resize='vertical';document.getElementById('expandPanel').style.display='inline-block';document.getElementById('restorePanel').style.display='none';});let currentDomain=window.location.hostname;function findUrls(){let urls=[],sources=[...document.getElementsByTagName('a'),...document.getElementsByTagName('script'),...document.getElementsByTagName('img'),...document.getElementsByTagName('link'),...document.getElementsByTagName('form')];sources.forEach(element=>{if(element.href)urls.push(element.href);if(element.src)urls.push(element.src);if(element.action)urls.push(element.action);});let content=document.documentElement.innerHTML;let urlPattern=/(?:url\(|href="|src="|action="|url:|endpoint:|path:|route:)\s*['"]?([^'"\)\s>]+)/gi;let match;while((match=urlPattern.exec(content))!==null){if(match[1]&&!match[1].startsWith('data:'))urls.push(match[1]);}performance.getEntriesByType('resource').forEach(entry=>{urls.push(entry.name);});return[...new Set(urls)];}function filterOpenRedirect(urls){const openRedirectPatterns=[/[?&](url|redir|return|returnUrl|src|r|redirect|redirect_url|redirect_uri|out|continue|dest|destination|go|link|next|view|callback|q|forward|u)=/i];return urls.filter(url=>openRedirectPatterns.some(pattern=>pattern.test(url))&&/https?:\/\//i.test(url));}let allUrls=findUrls();let openRedirectUrls=filterOpenRedirect(allUrls);function updateResults(filteredUrls){resultsContainer.innerHTML=filteredUrls.length>0?`<div style="margin:10px 0;color:#990000;">✅ Found ${filteredUrls.length} URLs:</div><div style="background:#333;padding:10px;border-radius:5px;">${filteredUrls.map(url=>`<div style="margin:5px 0;"><a href="${url}" target="_blank" style="color:white;text-decoration:none;padding:5px;background:#555;border-radius:3px;display:inline-block;word-break:break-word;" title="Open in new tab">${url}</a></div>`).join('')}</div>`:`<div style="color:#990000;">❌ No URLs found.</div>`;}document.getElementById('searchInput').addEventListener('input',()=>{let searchQuery=document.getElementById('searchInput').value.toLowerCase();let filteredUrls=allUrls.filter(url=>url.toLowerCase().includes(searchQuery));filteredUrls=filteredUrls.filter(url=>openRedirectUrls.includes(url));updateResults(filteredUrls);});document.getElementById('downloadBtn').addEventListener('click',()=>{let blob=new Blob([`Filtered URLs for ${currentDomain}\n\nAll URLs:\n${allUrls.join('\n')}\n\nOpen Redirect:\n${openRedirectUrls.join('\n')}\n`],{type:'text/plain'});let link=document.createElement('a');link.href=URL.createObjectURL(blob);link.download=`OpenRedirect_Results_${currentDomain}.txt`;link.click();});let resultsContainer=document.getElementById('results');updateResults(openRedirectUrls);})();
